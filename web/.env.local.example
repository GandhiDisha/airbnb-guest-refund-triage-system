# Copy to .env.local and fill in to connect real Supabase + Claude.
# With these unset, the app runs on mock data (src/lib/mock/fixtures.ts) and a
# templated narrative instead of an LLM call — see src/lib/config.ts.

# Supabase project (see ../supabase-schema.sql, ../seed-data.sql)
# Supabase — Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (see src/lib/generate-narrative.ts)
ANTHROPIC_API_KEY=

# Langfuse (offline eval only — see scripts/eval/, eval-criteria.md, ../product-brief.md §7.1)
# Langfuse Cloud project → Settings → API Keys. Not needed to run the app itself.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to https://cloud.langfuse.com (EU region). Set to
# https://us.cloud.langfuse.com for the US region, or your self-hosted URL.
LANGFUSE_BASE_URL=
